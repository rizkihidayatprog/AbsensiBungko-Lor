# Database connection string (MySQL / MariaDB)
DATABASE_URL="mysql://root:password@localhost:3306/absensi_sekolah"

# Auth Secret (JWT / Session)
# WAJIB diisi pada produksi. Minimal 32 karakter.
# Aplikasi akan menolak berjalan (gagal-keras) bila kosong atau terlalu pendek.
# Buat dengan: openssl rand -base64 48
AUTH_SECRET="your-generated-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# App Timezone
TZ="Asia/Jakarta"

# Password akun hasil seed (opsional).
# Bila dikosongkan, seed membuat password acak dan mencetaknya sekali di konsol.
# Minimum 8 karakter, memuat huruf dan angka.
SEED_ADMIN_PASSWORD="RahasiaSekolah2026"
SEED_GURU_PASSWORD="GuruSekolah2026"
